# Google Gemini API Key
# Required for live LLM reasoning (Trade-offs, Concept studio, Vendor quote comparison)
# If omitted or quota-exhausted, UtsavAI's built-in Deterministic Smart Fallback Engine
# will automatically serve rich, structured JSON responses without crashing.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (defaults to gemini-2.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash
